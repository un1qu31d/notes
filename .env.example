# Copy to .env and adjust. Every setting comes from here (NFR-14).

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://notes:notes@localhost:5433/notes?schema=public

# API
API_PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string
STORAGE_DRIVER=local

# Web app -> API (used by the Next.js /api rewrite)
API_URL=http://localhost:4000

# Owner account, used once by `npm run db:seed` (FR-04). Remove after seeding.
OWNER_EMAIL=
OWNER_PASSWORD=
